// Schéma Prisma — SANS+

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id    String @id @default(cuid(2))
  name  String
  title String

  categorieID String
  categorie   Categorie @relation(fields: [categorieID], references: [id])

  calories        Int?
  proteins        Int
  priceInCount    Decimal              @db.Decimal(4, 1)
  secondPriceInKg Decimal?             @db.Decimal(4, 1)
  unitCount       Int
  images          Media[]
  ingredient      ProductIngredients[]
  benefit         ProductBenefits[]
  slug            String               @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Categorie {
  id      String    @id @default(cuid(2))
  name    String    @unique
  slug    String    @unique
  product Product[]
}

model Benefit {
  id      String            @id @default(cuid(2))
  benef   String            @unique
  product ProductBenefits[]
}

model Ingredient {
  id      String               @id @default(cuid(2))
  name    String               @unique
  product ProductIngredients[]
}

model Media {
  id        String   @id @default(cuid())
  key       String?  @unique
  url       String  
  
  name      String
  size      Int?
  width     Int?
  height    Int?
  alt       String
  createdAt DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String?

  @@index([productId])
}

model ProductBenefits {
  idProd  String
  idBenef String

  product Product @relation(fields: [idProd], references: [id])
  benef   Benefit @relation(fields: [idBenef], references: [id])

  @@id([idProd, idBenef])
}

model ProductIngredients {
  idProd       String
  idIngredient String

  product    Product    @relation(fields: [idProd], references: [id])
  ingredient Ingredient @relation(fields: [idIngredient], references: [id])

  @@id([idProd, idIngredient])
}